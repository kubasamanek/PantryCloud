                      "    if (jsonData.value && jsonData.value.accessToken) {",
                      "        pm.collectionVariables.set(\"access_token\", jsonData.value.accessToken);",
                      "        pm.collectionVariables.set(\"refresh_token\", jsonData.value.refreshToken);",
                      "        console.log(\"Tokens refreshed and saved successfully\");",
