@* Dialog shown after depleting a pantry item. Lets the user optionally add the item to a shopping list (Source = Pantry). *@
<div class="pa-4">
    @if (_loading)
    {
        <MudProgressCircular Indeterminate Color="Color.Primary" />
    }
    else
    {
        <MudStack Spacing="3">
            <MudText Typo="Typo.body1">
                <strong>@ItemName</strong> has been marked as depleted.
                Would you like to add it to a shopping list to restock?
            </MudText>

            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudNumericField @bind-Value="_quantity"
                                 Label="Quantity"
                                 Variant="Variant.Outlined"
                                 Min="0.001m"
                                 Step="1m"
                                 Style="max-width: 120px;" />
                <MudSelect T="int" @bind-Value="_unit" Label="Unit" Variant="Variant.Outlined" Style="max-width: 150px;">
                    @foreach (var u in UnitDisplayHelper.AllUnits)
                    {
                        <MudSelectItem Value="@u">@UnitDisplayHelper.UnitLabel(u)</MudSelectItem>
                    }
                </MudSelect>
            </MudStack>

            @if (_lists.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    No shopping lists found. Create a shopping list first to add items.
                </MudAlert>
            }
            else
            {
                <MudSelect T="Guid" @bind-Value="_selectedListId" Label="Shopping list" Variant="Variant.Outlined">
                    @foreach (var list in _lists)
                    {
                        <MudSelectItem T="Guid" Value="@list.Id">@list.Name</MudSelectItem>
                    }
                </MudSelect>
            }

            @if (_error)
            {
                <MudAlert Severity="Severity.Error" Dense="true">Failed to add to shopping list. Please try again.</MudAlert>
            }

            <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                <MudButton Variant="Variant.Text" OnClick="Skip">Skip</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="@(_lists.Count == 0 || _selectedListId == Guid.Empty || _adding)"
                           OnClick="AddToList">
                    @(_adding ? "Adding…" : "Add to list")
                </MudButton>
            </MudStack>
        </MudStack>
    }
</div>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string ItemName { get; set; } = "";
    [Parameter] public int ItemUnit { get; set; }
    [Inject] private IShoppingListApi ShoppingListApi { get; set; } = null!;

    private bool _loading = true;
    private List<ShoppingListSummaryDto> _lists = [];
    private Guid _selectedListId;
    private decimal _quantity = 1;
    private int _unit;
    private bool _adding;
    private bool _error;

    protected override async Task OnInitializedAsync()
    {
        _unit = ItemUnit;
        var result = await ShoppingListApi.ListListsAsync(1, 100);
        _lists = result.Data?.Lists.ToList() ?? [];
        if (_lists.Count > 0)
            _selectedListId = _lists[0].Id;
        _loading = false;
    }

    private async Task AddToList()
    {
        if (_selectedListId == Guid.Empty) return;

        _adding = true;
        _error = false;
        StateHasChanged();

        var request = new AddShoppingListItemRequest
        {
            Name = ItemName,
            Quantity = _quantity,
            Unit = _unit,
            Source = 1 // ItemSource.Pantry
        };

        var result = await ShoppingListApi.AddItemAsync(_selectedListId, request);
        if (result != null)
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            _error = true;
            _adding = false;
            StateHasChanged();
        }
    }

    private void Skip() => MudDialog.Close(DialogResult.Ok(false));
}
