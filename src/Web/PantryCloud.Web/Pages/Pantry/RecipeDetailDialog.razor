@* Displays full recipe detail (ingredients, steps) loaded via GetRecipeAsync. *@
<div class="pa-6">
    @if (_loading)
    {
        <MudProgressCircular Indeterminate Color="Color.Primary" />
    }
    else if (_recipe == null)
    {
        <MudAlert Severity="Severity.Warning">Recipe not found.</MudAlert>
    }
    else
    {
        <MudStack Spacing="3">
            <MudText Typo="Typo.h6">@_recipe.Title</MudText>
            @if (!string.IsNullOrWhiteSpace(_recipe.Description))
            {
                <MudText Typo="Typo.body1">@_recipe.Description</MudText>
            }
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                <MudChip T="string" Size="Size.Small">Prep: @_recipe.PrepTimeMinutes min</MudChip>
                <MudChip T="string" Size="Size.Small">Cook: @_recipe.CookTimeMinutes min</MudChip>
                <MudChip T="string" Size="Size.Small">Servings: @_recipe.Servings</MudChip>
                @foreach (var tag in _recipe.Tags)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@tag</MudChip>
                }
            </MudStack>

            <MudText Typo="Typo.subtitle1">Ingredients</MudText>
            <MudStack Spacing="0">
                @foreach (var ing in _recipe.Ingredients)
                {
                    var label = (ing.Quantity > 0 ? $"{ing.Quantity} {UnitDisplayHelper.UnitLabel(ing.Unit)} " : "") +
                                ing.Name +
                                (ing.IsOptional ? " (optional)" : "");
                    <MudCheckBox T="bool"
                                 Value="@_checkedIngredients.Contains(ing.Name)"
                                 ValueChanged="@(v => ToggleIngredient(ing.Name, v))"
                                 Dense="true"
                                 Label="@label" />
                }
            </MudStack>

            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle2">Add checked ingredients to shopping list</MudText>
                @if (_lists.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        No shopping lists found. Create a shopping list first to add ingredients.
                    </MudAlert>
                }
                else
                {
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <MudSelect T="Guid" @bind-Value="_selectedListId" Label="Shopping list" Variant="Variant.Outlined" Dense="true" Style="min-width: 200px;">
                            @foreach (var list in _lists)
                            {
                                <MudSelectItem T="Guid" Value="@list.Id">@list.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   Disabled="@(_checkedIngredients.Count == 0 || _selectedListId == Guid.Empty || _adding)"
                                   OnClick="AddToShoppingList">
                            @(_adding ? "Adding…" : "Add to list")
                        </MudButton>
                    </MudStack>
                    @if (_addError)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true">Failed to add items. Please try again.</MudAlert>
                    }
                    @if (_addSuccess)
                    {
                        <MudAlert Severity="Severity.Success" Dense="true">Items added to list.</MudAlert>
                    }
                }
            </MudStack>

            <MudText Typo="Typo.subtitle1">Steps</MudText>
            <MudList T="string" Dense="true">
                @foreach (var step in _recipe.Steps.OrderBy(s => s.StepNumber))
                {
                    <MudListItem T="string">
                        <MudText Typo="Typo.body2"><strong>@step.StepNumber.</strong> @step.Instruction</MudText>
                        @if (step.DurationMinutes.HasValue && step.DurationMinutes > 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@step.DurationMinutes min</MudText>
                        }
                    </MudListItem>
                }
            </MudList>

            <MudStack Row="true" Justify="Justify.FlexEnd">
                <MudButton Variant="Variant.Text" OnClick="Close">Close</MudButton>
            </MudStack>
        </MudStack>
    }
</div>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid RecipeId { get; set; }
    [Parameter] public HashSet<string> PantryIngredientNames { get; set; } = [];
    [Inject] private IRecipeApi RecipeApi { get; set; } = null!;
    [Inject] private IShoppingListApi ShoppingListApi { get; set; } = null!;

    private RecipeDto? _recipe;
    private bool _loading = true;
    private HashSet<string> _checkedIngredients = new(StringComparer.OrdinalIgnoreCase);
    private List<ShoppingListSummaryDto> _lists = [];
    private Guid _selectedListId;
    private bool _adding;
    private bool _addError;
    private bool _addSuccess;

    protected override async Task OnInitializedAsync()
    {
        var recipeTask = RecipeApi.GetRecipeAsync(RecipeId);
        var listsTask = ShoppingListApi.ListListsAsync(1, 100);
        await Task.WhenAll(recipeTask, listsTask);

        _recipe = recipeTask.Result?.Recipe;

        if (_recipe != null)
        {
            foreach (var ing in _recipe.Ingredients)
            {
                if (!PantryIngredientNames.Contains(ing.Name))
                    _checkedIngredients.Add(ing.Name);
            }
        }

        _lists = listsTask.Result.Data?.Lists.ToList() ?? [];
        if (_lists.Count > 0)
            _selectedListId = _lists[0].Id;

        _loading = false;
    }

    private void ToggleIngredient(string name, bool isChecked)
    {
        if (isChecked) _checkedIngredients.Add(name);
        else _checkedIngredients.Remove(name);
    }

    private async Task AddToShoppingList()
    {
        if (_selectedListId == Guid.Empty || _checkedIngredients.Count == 0 || _recipe == null)
            return;

        _adding = true;
        _addError = false;
        _addSuccess = false;
        StateHasChanged();

        var items = _recipe.Ingredients
            .Where(ing => _checkedIngredients.Contains(ing.Name))
            .Select(ing => new AddShoppingListItemRequest
            {
                Name = ing.Name,
                Quantity = ing.Quantity > 0 ? ing.Quantity : 1,
                Unit = ing.Unit,
                Source = 2 // Recipe
            })
            .ToList();

        var result = await ShoppingListApi.AddItemsBatchAsync(_selectedListId, new AddShoppingListItemsBatchRequest { Items = items });

        _addError = result == null;
        _addSuccess = result != null;
        _adding = false;
        StateHasChanged();
    }

    private void Close() => MudDialog.Close();
}
