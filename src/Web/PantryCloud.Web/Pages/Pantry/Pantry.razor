@page "/pantry"
@attribute [Authorize]

<PageTitle>Pantry - PantryCloud</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudText Typo="Typo.h5" Class="mb-4">Pantry</MudText>
    <MudPaper Class="pa-8" Elevation="2">
        <MudStack Spacing="3" AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-8">
            <MudIcon Icon="@Icons.Material.Filled.Kitchen" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Your pantry will appear here</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">This section is not yet connected. It will show your household pantry once the service is integrated.</MudText>
        </MudStack>
    </MudPaper>
</MudContainer>
