@page "/reset-password"
@attribute [AllowAnonymous]

<PageTitle>Reset password - PantryCloud</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    @if (_invalidLink)
    {
        <MudAlert Severity="Severity.Error">Invalid or expired reset link.</MudAlert>
        <MudLink Href="/forgot-password" Class="mt-4">Request a new link</MudLink>
    }
    else if (_model != null)
    {
        <MudPaper Class="pa-8" Elevation="2">
            <MudText Typo="Typo.h5" Class="mb-6">Set new password</MudText>
            <EditForm Model="_model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <MudTextField @bind-Value="_model.NewPassword" Label="New password" Variant="Variant.Outlined" InputType="InputType.Password" Class="mb-4" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mb-2" Disabled="_loading">
                    @(_loading ? "Resetting..." : "Reset password")
                </MudButton>
            </EditForm>
            <MudStack Row="true" Class="mt-4">
                <MudLink Href="/login" Typo="Typo.body2">Back to sign in</MudLink>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudProgressCircular Indeterminate />
    }
</MudContainer>

@code {
    [Inject] private IAuthApi AuthApi { get; set; } = null!;
    [Inject] private NavigationManager Navigation { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private ResetPasswordRequest? _model;
    private bool _loading;
    private bool _invalidLink;

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
            _invalidLink = true;
        else
            _model = new ResetPasswordRequest { Email = Email!, Token = Token! };
    }

    private async Task HandleSubmit()
    {
        if (_model == null) return;
        _loading = true;
        try
        {
            var success = await AuthApi.ResetPasswordAsync(_model);
            if (success)
            {
                Snackbar.Add("Password reset. You can sign in now.", Severity.Success);
                Navigation.NavigateTo("/login", forceLoad: true);
            }
            else
            {
                Snackbar.Add("Reset failed. Link may have expired.", Severity.Error);
            }
        }
        finally
        {
            _loading = false;
        }
    }
}
