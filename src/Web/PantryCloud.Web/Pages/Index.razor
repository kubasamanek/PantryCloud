@page "/"
@attribute [AllowAnonymous]

<PageTitle>PantryCloud</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Welcome to PantryCloud</MudText>
<AuthorizeView>
    <Authorized>
        <MudText Typo="Typo.body1" Class="mb-4">Hello, @_displayName!</MudText>
        <MudStack Spacing="2" Class="mb-4">
            <HouseholdSummary />
            @if (_loading && _household != null)
            {
                <MudProgressCircular Indeterminate Color="Color.Primary" Size="Size.Small" />
            }
            else if (_household != null && _members != null)
            {
                <MudText Typo="Typo.h6" Class="mt-4 mb-2">Household members</MudText>
                <MudStack Spacing="2">
                    @foreach (var member in _members.Members)
                    {
                        <MudCard Elevation="1" Class="pa-3">
                            <MudStack Spacing="1" Row="true" AlignItems="AlignItems.Center">
                                <MudAvatar Size="Size.Small" image="@member.AvatarUrl" Color="Color.Primary">@((member.DisplayName ?? "M").Substring(0, 1).ToUpperInvariant())</MudAvatar>
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body1">@(member.DisplayName ?? "Member")</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@HouseholdDisplayHelper.RoleLabel(member.Role) · @HouseholdDisplayHelper.DietaryProfileLabel(member.DietaryProfile)</MudText>
                                    @if (member.ExcludedIngredients?.Count > 0)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Excluded: @string.Join(", ", member.ExcludedIngredients)</MudText>
                                    }
                                </MudStack>
                            </MudStack>
                        </MudCard>
                    }
                </MudStack>
                <MudLink Href="@Routes.Household" Typo="Typo.body2" Class="mt-2">Manage household</MudLink>
            }
        </MudStack>
    </Authorized>
    <NotAuthorized>
        <MudText Typo="Typo.body1" Class="mb-4">Sign in to get started.</MudText>
        <MudStack Row="true" Spacing="2">
            <MudLink Href="@Routes.Login" Typo="Typo.body1">Sign in</MudLink>
            <MudText Typo="Typo.body1">or</MudText>
            <MudLink Href="@Routes.Register" Typo="Typo.body1">Create account</MudLink>
        </MudStack>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Inject] private ICurrentProfileService CurrentProfile { get; set; } = null!;
    [Inject] private IHouseholdApi HouseholdApi { get; set; } = null!;
    [Inject] private AuthenticationStateProvider AuthState { get; set; } = null!;

    private string _displayName = "User";
    private GetCurrentHouseholdResponse? _household;
    private GetHouseholdMembersResponse? _members;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            await CurrentProfile.EnsureLoadedAsync();
            _displayName = CurrentProfile.DisplayName ?? state.User.Identity?.Name ?? "User";
            _loading = true;
            try
            {
                _household = await HouseholdApi.GetCurrentHouseholdAsync();
                if (_household != null)
                    _members = await HouseholdApi.GetHouseholdMembersAsync();
            }
            finally
            {
                _loading = false;
            }
        }
    }
}
