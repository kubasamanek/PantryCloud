@page "/recipes"
@attribute [Authorize]

<PageTitle>Recipes - PantryCloud</PageTitle>

<MudContainer Class="mt-8">
    <MudStack Spacing="2" AlignItems="AlignItems.Center">
        <MudProgressCircular Indeterminate Color="Color.Primary" Size="Size.Small" />
        <MudText Typo="Typo.body2">Redirecting to Pantry…</MudText>
    </MudStack>
</MudContainer>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = null!;

    protected override void OnInitialized()
    {
        Navigation.NavigateTo(Routes.Pantry, replace: true);
    }
}
