@page "/forgot-password"
@attribute [AllowAnonymous]

<PageTitle>Forgot password - PantryCloud</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Class="pa-8" Elevation="2">
        <MudText Typo="Typo.h5" Class="mb-6">Forgot password</MudText>
        <EditForm Model="_model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <MudTextField @bind-Value="_model.Email" Label="Email" Variant="Variant.Outlined" InputType="InputType.Email" Class="mb-4" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mb-2" Disabled="_loading">
                @(_loading ? "Sending..." : "Send reset link")
            </MudButton>
        </EditForm>
        @if (_sent && !string.IsNullOrEmpty(_resetLinkUrl))
        {
            <MudAlert Severity="Severity.Info" Class="mt-4">
                <MudText Typo="Typo.body2" Class="mb-2">Email is not configured yet. Use this link to reset your password:</MudText>
                <MudLink Href="@_resetLinkUrl" Target="_blank" Typo="Typo.body2" Class="word-break-all">@_resetLinkUrl</MudLink>
            </MudAlert>
        }
        else if (_sent)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-4">No account found for this email, or the request failed.</MudAlert>
        }
        <MudStack Row="true" Class="mt-4">
            <MudLink Href="/login" Typo="Typo.body2">Back to sign in</MudLink>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    [Inject] private IAuthApi AuthApi { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    private readonly ForgotPasswordRequest _model = new();
    private bool _loading;
    private bool _sent;
    private string? _resetLinkUrl;

    private async Task HandleSubmit()
    {
        _loading = true;
        _sent = false;
        _resetLinkUrl = null;
        try
        {
            var response = await AuthApi.ForgotPasswordAsync(_model);
            _sent = true;
            if (response != null)
                _resetLinkUrl = response.Url;
            else
                Snackbar.Add("Request failed. Please try again.", Severity.Warning);
        }
        finally
        {
            _loading = false;
        }
    }
}
