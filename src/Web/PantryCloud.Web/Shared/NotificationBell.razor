@implements IDisposable

<MudMenu AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" Style="max-width: 400px;">
    <ActivatorContent>
        @if (_unreadCount > 0)
        {
            <MudBadge Content="@_unreadCount" Color="Color.Error" Overlap="true">
                <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" aria-label="Notifications" Class="mr-1" />
            </MudBadge>
        }
        else
        {
            <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" aria-label="Notifications" Class="mr-1" />
        }
    </ActivatorContent>
    <ChildContent>
        <MudPaper Class="pa-4" Style="max-width: 400px; max-height: 70vh; overflow-y: auto;">
            <MudStack Spacing="2">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.subtitle1">Notifications</MudText>
                    @if (_unreadCount > 0)
                    {
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="MarkAllRead">Mark all read</MudButton>
                    }
                </MudStack>
                @if (_list.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No notifications</MudText>
                }
                else
                {
                    @foreach (var n in _list)
                    {
                        <MudPaper Class="pa-3" Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default);">
                            <MudStack Spacing="1">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">@n.Title</MudText>
                                    @if (!StateService.IsRead(n.Id))
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => Dismiss(n.Id))" aria-label="Dismiss" />
                                    }
                                </MudStack>
                                <MudText Typo="Typo.body2">@n.Message</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatTime(n.CreatedAt)</MudText>
                            </MudStack>
                        </MudPaper>
                    }
                }
            </MudStack>
        </MudPaper>
    </ChildContent>
</MudMenu>

@code {
    [Inject] private INotificationStateService StateService { get; set; } = null!;
    [Inject] private INotificationHubClient HubClient { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    private int _unreadCount;
    private IReadOnlyList<NotificationMessage> _list = [];

    protected override void OnInitialized()
    {
        HubClient.OnNotification += OnLiveNotification;
        StateService.StateChanged += OnStateChanged;
        RefreshFromState();
    }

    public void Dispose()
    {
        HubClient.OnNotification -= OnLiveNotification;
        StateService.StateChanged -= OnStateChanged;
    }

    private void OnLiveNotification(NotificationMessage msg)
    {
        InvokeAsync(() =>
        {
            Snackbar.Add($"{msg.Title}: {msg.Message}", SeverityFromType(msg.Type), config => { config.VisibleStateDuration = 4000; });
            StateHasChanged();
        });
    }

    private static Severity SeverityFromType(int type) => type switch
    {
        1 => Severity.Success,
        2 => Severity.Warning,
        3 => Severity.Error,
        _ => Severity.Info
    };

    private void OnStateChanged()
    {
        InvokeAsync(() =>
        {
            RefreshFromState();
            StateHasChanged();
        });
    }

    private void RefreshFromState()
    {
        _unreadCount = StateService.UnreadCount;
        _list = StateService.GetListForPanel();
    }

    private void Dismiss(Guid id)
    {
        StateService.MarkAsRead(id);
    }

    private void MarkAllRead()
    {
        StateService.MarkAllAsRead();
    }

    private static string FormatTime(DateTime createdAt)
    {
        var diff = DateTime.UtcNow - createdAt;
        if (diff.TotalMinutes < 1) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        return createdAt.ToLocalTime().ToString("g");
    }
}
