@implements IAsyncDisposable
@inject ITokenStorage TokenStorage
@inject JwtClaimsHelper JwtHelper

@if (_expiresInText != null)
{
    <MudTooltip Text="@_tooltipText">
        <span class="token-expiry-label">@_expiresInText</span>
    </MudTooltip>
}

@code {
    private string? _expiresInText;
    private string _tooltipText = "";
    private Timer? _timer;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        await UpdateDisplayAsync();
        _timer = new Timer(_ =>
        {
            try { InvokeAsync(UpdateDisplayAsync); }
            catch { /* avoid unhandled exception in timer */ }
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private async Task UpdateDisplayAsync()
    {
        if (_disposed) return;
        if (TokenStorage == null || JwtHelper == null) return;
        var accessToken = await TokenStorage.GetAccessTokenAsync();
        var (_, exp, iat) = JwtHelper.DecodePayload(accessToken);

        if (exp == null)
        {
            _expiresInText = null;
            return;
        }

        var expUtc = DateTimeOffset.FromUnixTimeSeconds(exp.Value);
        var now = DateTimeOffset.UtcNow;
        var remaining = expUtc - now;

        if (remaining <= TimeSpan.Zero)
        {
            _expiresInText = "Token expired";
            _tooltipText = "Session expired. Refresh the page or sign in again.";
            return;
        }

        _expiresInText = remaining.TotalHours >= 1
            ? $"Expires in {(int)remaining.TotalHours}h {remaining.Minutes}m"
            : remaining.TotalMinutes >= 1
                ? $"Expires in {remaining.Minutes}m {remaining.Seconds}s"
                : $"Expires in {remaining.Seconds}s";

        var expiresAtLocal = expUtc.ToLocalTime().ToString("HH:mm:ss");
        var tooltipParts = new List<string> { $"Expires at {expiresAtLocal} (local)" };
        if (iat != null)
        {
            var iatLocal = DateTimeOffset.FromUnixTimeSeconds(iat.Value).ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
            tooltipParts.Add($"Last refreshed: {iatLocal}");
        }
        _tooltipText = string.Join(" · ", tooltipParts);
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _timer?.Dispose();
        _timer = null;
        await Task.CompletedTask;
    }
}
