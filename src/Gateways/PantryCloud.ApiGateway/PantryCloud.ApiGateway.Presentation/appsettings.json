{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "Gateway": {
    "Port": 5050,
    "EnableSwagger": true,
    "RateLimit": {
      "Enabled": true,
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Resilience": {
      "RequestTimeoutSeconds": 30,
      "CircuitBreaker": {
        "Enabled": true,
        "FailureThreshold": 5,
        "DurationOfBreakSeconds": 30,
        "SamplingDurationSeconds": 60,
        "MinimumThroughput": 10
      },
      "Retry": {
        "Enabled": true,
        "MaxRetryAttempts": 3,
        "BaseDelayMilliseconds": 1000
      }
    }
  },
  "Services": {
    "IdentityService": "http://identity-api:8080",
    "HouseholdService": "http://household-api:8080",
    "PantryService": "http://pantry-api:8080",
    "RecipeService": "http://recipe-api:8080",
    "ShoppingListService": "http://shoppinglist-api:8080"
  },
  "Jwt": {
    "Issuer": "pantry-identity",
    "Audience": "pantry-cloud"
  },
  "App": {
    "IdentityUrl": "http://identity-api:8080"
  },
  "AllowedHosts": "*"
}

